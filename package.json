{
  "name": "typescript-eslint-browserify",
  "version": "1.0.0",
  "description": "Use typescript-eslint in the browser",
  "main": "./tseslint.cjs",
  "module": "./tseslint.mjs",
  "browser": "./tseslint.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./tseslint.mjs",
      "default": "./tseslint.cjs"
    },
    "./tseslint.js": "./tseslint.js",
    "./tseslint.min.js": "./tseslint.min.js"
  },
  "files": [
    "index.d.ts",
    "tseslint.js",
    "tseslint.min.js",
    "tseslint.mjs",
    "tseslint.cjs"
  ],
  "scripts": {
    "test": "node test.cjs && node test.mjs",
    "build": "rollup --config",
    "lint": "eslint"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "10.8.1",
    "eslint-linter-browserify": "10.8.1",
    "rollup": "^4.62.4",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
